generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id       String @id @default(cuid())
  nome     String
  telefone String

  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmTerm     String? @map("utm_term")
  utmContent  String? @map("utm_content")

  /// Guardados para uma futura integração de conversões offline com o Google Ads.
  gclid  String?
  gbraid String?
  wbraid String?

  landingPage String @map("landing_page")

  /// Evidência de consentimento LGPD no momento do envio.
  consentimento Boolean

  /// Definido pelo servidor, nunca pelo cliente.
  convertedAt DateTime @default(now()) @map("converted_at")

  @@index([convertedAt])
  @@index([gclid])
  @@map("leads")
}
