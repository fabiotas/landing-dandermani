# Postgres da VPS acessado por túnel SSH (nenhuma porta aberta no firewall).
# Abra o túnel em outro terminal e deixe rodando.
#
# Para uso com Docker, o túnel precisa escutar no gateway da bridge, senão o
# container não alcança (o padrão do SSH é só 127.0.0.1):
#   ssh -L 172.17.0.1:5432:localhost:5432 usuario@sua-vps -N
#
# Fora do Docker basta o padrão:
#   ssh -L 5432:localhost:5432 usuario@sua-vps -N

# Rodando via Docker: o túnel está no host, não dentro do container.
DATABASE_URL="postgresql://USUARIO:SENHA@host.docker.internal:5432/BANCO?schema=public"

# Rodando o Next direto na máquina (sem Docker), use localhost:
# DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/BANCO?schema=public"

# Em produção a aplicação roda na própria VPS, ao lado do banco:
# DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/BANCO?schema=public"

# URL pública do site. Usada como base para Open Graph e metadata do Next.
# NEXT_PUBLIC_SITE_URL="https://seu-dominio.com.br"

# Só marque true quando houver um proxy sobrescrevendo X-Forwarded-For.
# O compose já define isso no perfil de produção.
# TRUST_PROXY=true
